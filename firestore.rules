rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "1BMeS4vGMDPBXRmYBVNSNvR3ByM2";
    }

    match /appData/{dataset}/items/{itemId} {
      allow read, write: if isAdmin()
        && dataset in [
          "sell", "buy", "products", "trending", "popular", "feedback",
          "reviews", "sellModels", "vehicles", "vehicleLeads", "vehicleProducts"
        ];
    }
  }
}
